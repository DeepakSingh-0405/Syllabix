# Syllabix Environment Variables Template

# ==============================================================================
# Backend Configuration (Place in server/.env)
# ==============================================================================
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb://localhost:27017/syllabix_db
REDIS_URL=redis://localhost:6379

# Supabase Auth & Storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_ANON_KEY=your_anon_key_here

# Google Gemini AI Key
GEMINI_API_KEY=your_gemini_api_key_here

# Security Flags (Development Only)
ALLOW_DEMO_TOKENS=true

# ==============================================================================
# Frontend Configuration (Place in client/.env)
# ==============================================================================
VITE_API_BASE_URL=http://localhost:5001/api/v1
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here
